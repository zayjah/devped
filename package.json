{
  "name": "devped-ph-api",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Workers + D1 + KV backend for DevPed PH",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "db:migrate:local": "wrangler d1 migrations apply devped-ph-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply devped-ph-db --remote",
    "db:migrate:staging": "wrangler d1 migrations apply devped-ph-db-staging --remote --env staging",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@cloudflare/workers-types": "^4.20250801.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.20.0"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  }
}
