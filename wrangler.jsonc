{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devped-ph-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },

  // ---- D1 -------------------------------------------------------------
  // Create with: wrangler d1 create devped-ph-db
  // Then paste the returned database_id below. Migrations are read from
  // ./migrations by default (matches the folder in this repo), applied with:
  //   wrangler d1 migrations apply devped-ph-db --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devped-ph-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],

  // ---- KV ---------------------------------------------------------------
  // Create with: wrangler kv namespace create CACHE
  //              wrangler kv namespace create RATE_LIMIT
  "kv_namespaces": [
    { "binding": "CACHE", "id": "REPLACE_WITH_YOUR_CACHE_KV_ID" },
    { "binding": "RATE_LIMIT", "id": "REPLACE_WITH_YOUR_RATE_LIMIT_KV_ID" }
  ],

  // ---- Plain (non-secret) vars -----------------------------------------
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://devped.ph,https://www.devped.ph,https://devped-ph-web.pages.dev",
    "SKIP_TURNSTILE": "false"
  },

  // ---- Cron Trigger for the automatic import / cross-matching pipeline --
  // Nightly at 02:00 UTC (10:00 AM PHT). Adjust to taste.
  "triggers": {
    "crons": ["0 2 * * *"]
  },

  // Secrets are NOT set here — see README §4. Set with:
  //   wrangler secret put TURNSTILE_SECRET_KEY
  //   wrangler secret put ADMIN_API_KEY
  //
  // Per-environment overrides (wrangler --env staging, etc.) can go under
  // "env": { "staging": { "vars": {...}, "d1_databases": [...] } }

  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "development",
        "ALLOWED_ORIGINS": "*",
        "SKIP_TURNSTILE": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "devped-ph-db-staging",
          "database_id": "REPLACE_WITH_YOUR_STAGING_D1_DATABASE_ID"
        }
      ],
      "kv_namespaces": [
        { "binding": "CACHE", "id": "REPLACE_WITH_YOUR_STAGING_CACHE_KV_ID" },
        { "binding": "RATE_LIMIT", "id": "REPLACE_WITH_YOUR_STAGING_RATE_LIMIT_KV_ID" }
      ]
    }
  }
}
